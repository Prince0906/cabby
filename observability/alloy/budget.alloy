// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }
//
// Decision 014 (option B, "moderate trim"): keep every lab_* and traefik_* series and what the dashboard
// and the SLOs read; drop the families nobody looks at and the labels that change on every deploy.
// An action = "drop" rule removes a series when its source labels, joined with ";", match the regex.

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// node_exporter reporting on itself (46 series per host): not about the lab.
		rule {
			source_labels = ["__name__"]
			regex         = "node_scrape_collector_.*"
			action        = "drop"
		}

		// Docker's virtual network devices. Each container gets a veth with a random name, so every
		// deploy mints a new set of series. eth0 and lo stay: they show the host's real traffic.
		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_.*;(veth.*|br-.*|docker0)"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Per-container filesystem counters: about 16 families of 37-44 series each, and neither the
		// dashboard nor an SLO reads them. container_memory_working_set_bytes (the dashboard's) stays.
		rule {
			source_labels = ["__name__"]
			regex         = "container_fs_.*"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Nothing dropped: the services' series are about 330 in all, and they are what the dashboard,
		// the SLOs and the S8 canary read (contracts/metrics.yaml). Keeping them whole is the point.
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
