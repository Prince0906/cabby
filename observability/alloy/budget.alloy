// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }
//
// Decision 014 (a keep-only list for the host and the containers): send only the series a dashboard, an SLO
// or an incident would read. A "keep" rule drops every series whose name does not match, so a new metric
// family is not sent until it is added here. The services (the app, serving, Traefik) are kept whole.
// Rules run in order, top to bottom.

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Docker's virtual network devices. Each container gets a veth with a random name, so every
		// deploy would mint a new set of series. This runs before the keep list because the network
		// totals below are kept for every device that is left (eth0, lo).
		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_.*;(veth.*|br-.*|docker0)"
			action        = "drop"
		}

		// Keep only: whether the target answered (up), CPU, memory, disk space, load, and network totals.
		rule {
			source_labels = ["__name__"]
			regex         = "up|node_cpu_seconds_total|node_memory_MemAvailable_bytes|node_memory_MemTotal_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_load1|node_network_receive_bytes_total|node_network_transmit_bytes_total"
			action        = "keep"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Keep only: whether cAdvisor answered (up), memory (the dashboard's), CPU, and the start time
		// (a changed start time means a restart).
		rule {
			source_labels = ["__name__"]
			regex         = "up|container_memory_working_set_bytes|container_cpu_usage_seconds_total|container_start_time_seconds"
			action        = "keep"
		}

		// `id` is the container's cgroup path and `image` carries the image tag: both change on every
		// deploy and would mint a new series each time. `name` (lab-app-app-blue-1 and so on) stays the
		// same, and it is the only one the dashboard reads.
		rule {
			regex  = "id|image"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Nothing dropped: the services' series are about 330 in all, and they are what the dashboard,
		// the SLOs and the S8 canary read (contracts/metrics.yaml). Keeping them whole is the point.
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
